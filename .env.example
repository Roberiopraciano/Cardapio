# URL base do backend Laravel (sem barra no final)
VITE_API_URL=https://api.seudominio.com.br

# Analytics — plataforma (opcional, global para todas as branches)
VITE_META_PIXEL_ID=
VITE_GA_MEASUREMENT_ID=

# Google Sign-In (opcional) — preenche nome e e-mail na identificação.
# O Google NÃO devolve telefone; o cliente digita esse campo de qualquer forma.
# Precisa TAMBÉM de settingsWeb.googleSignInEnabled = true na branch.
# Console: https://console.cloud.google.com → Credenciais → ID do cliente OAuth
# (tipo "Aplicativo da Web", com o domínio do cardápio em "Origens JavaScript autorizadas")
VITE_GOOGLE_CLIENT_ID=

# Analytics — por branch (configurado em branch.settingsWeb no Laravel):
# settingsWeb.metaPixelId = "123456789012345"
# settingsWeb.gaId        = "G-XXXXXXXXXX"
